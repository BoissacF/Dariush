# =============================================================================
#  Dariush — modele de fichier .env  (cote PHP)
# -----------------------------------------------------------------------------
#  COPIER ce fichier sous le nom  .env  puis y mettre les vraies valeurs.
#  Le .env ne doit JAMAIS etre versionne ni depose dans un dossier servi par
#  le serveur web : le placer UN NIVEAU AU-DESSUS de la racine web.
#
#  Emplacements :
#    VPS   : le dossier parent de celui qui contient Dariush_Commun/
#    MAMP  : C:\MAMP\.env        (au-dessus de htdocs)
# =============================================================================

# --- Base de donnees MySQL ---------------------------------------------------
DB_HOST=localhost
DB_NAME=DariushPython
DB_USER=dariush
DB_PASS=

# --- Cles API ----------------------------------------------------------------
# DeepSeek : service PAYANT (solde prepaye). https://platform.deepseek.com
DEEPSEEK_KEY=
# Groq : offre gratuite. https://console.groq.com
GROQ_KEY=

# --- Codes raccourcis saisis dans le champ "cle API" de l'interface ----------
# Taper ce code au lieu d'une vraie cle donne acces a la cle correspondante.
TEACHER_SHORTCUT_CODE=
GROQ_SHORTCUT_CODE=

# --- Jeton protegeant Rag_extraction.php et Rag_classement.php ---------------
# Appel : https://.../Dariush_Commun/Rag_extraction.php?token=CE_JETON
RAG_TOKEN=
